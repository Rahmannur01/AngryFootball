# Environment variables for docker-compose
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at

# Development mode (set to "true" to hide Telegram OAuth button on localhost)
DEV_MODE=true

BASE_URL=http://localhost:8001
ROOT_PATH=/angryfootball

# Database (use a unique password and URL-encode special characters in DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=angryfootball
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-random-password@postgres:5432/angryfootball

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
