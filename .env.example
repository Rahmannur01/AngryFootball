# Environment variables for docker-compose
BASE_URL=http://localhost:8001
ROOT_PATH=
# Keep 127.0.0.1 for local runs. On the server, use the private Docker bridge
# address (for example 172.17.0.1) so ContestBot can reach the backend without
# exposing port 8001 on the public network interface.
BACKEND_BIND_ADDRESS=127.0.0.1

# Database (use a unique password and URL-encode special characters in DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=angryfootball
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-random-password@postgres:5432/angryfootball

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Registration email (Yandex SMTP with an application password)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=your_yandex_login
SMTP_PASSWORD=your_yandex_app_password
SMTP_FROM_EMAIL=your_yandex_login@yandex.ru
SMTP_FROM_NAME=Angry Football
SMTP_USE_SSL=true
SMTP_USE_TLS=false
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_SENDS_PER_HOUR=5
REGISTRATION_TOKEN_EXPIRE_MINUTES=15
